  (footprint "0G-LockControl:TP_Coax_50R_NanoVNA" (layer "F.Cu")
    (tstamp bd0f7dd9-2812-5bca-9e8b-5fbaa46c6d4f)
    (at 39.25 34)
    (descr "Isla de 3 pads para soldar un pigtail coaxial de 50 ohm (RG-178 o semirrigido) y medir S11 con NanoVNA. Pad 1 = malla/GND izquierda, pad 2 = vivo, pad 3 = malla/GND derecha. La separacion vivo-malla es 0.15 mm, la misma del CPWG, para no crear discontinuidad. Solo para la placa de prueba y ajuste: no va en el producto.")
    (tags "coax test point NanoVNA S11 RF 50ohm")
    (attr smd exclude_from_pos_files exclude_from_bom)
