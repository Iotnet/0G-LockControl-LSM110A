# Modificacion en Core/Src/stm32wlxx_it.c
# Agregar los handlers EXTI para los 3 botones y el callback compartido.

--- a/Core/Src/stm32wlxx_it.c
+++ b/Core/Src/stm32wlxx_it.c
@@ -20,7 +20,7 @@
 /* Includes ------------------------------------------------------------------*/
 #include "main.h"
 #include "stm32wlxx_it.h"
 /* Private includes ----------------------------------------------------------*/
 /* USER CODE BEGIN Includes */
-
+#include "buttons_app.h"
 /* USER CODE END Includes */

@@ -288,5 +288,38 @@ void SUBGHZ_Radio_IRQHandler(void)
 /* USER CODE BEGIN 1 */

+/**
+  * @brief This function handles EXTI Line 0 Interrupt (B1 = PA0).
+  */
+void EXTI0_IRQHandler(void)
+{
+  HAL_GPIO_EXTI_IRQHandler(BUT1_Pin);
+}
+
+/**
+  * @brief This function handles EXTI Line 1 Interrupt (B2 = PA1).
+  */
+void EXTI1_IRQHandler(void)
+{
+  HAL_GPIO_EXTI_IRQHandler(BUT2_Pin);
+}
+
+/**
+  * @brief This function handles EXTI Lines [9:5] Interrupt (B3 = PC6).
+  */
+void EXTI9_5_IRQHandler(void)
+{
+  HAL_GPIO_EXTI_IRQHandler(BUT3_Pin);
+}
+
+/**
+  * @brief HAL EXTI shared callback. Delega al modulo buttons_app.
+  *        Se ejecuta despues de que HAL limpie el pending bit.
+  */
+void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
+{
+  Buttons_HandleEXTI(GPIO_Pin);
+}
+
 /* USER CODE END 1 */

# Que hace:
#   - EXTI0_IRQHandler   captura la interrupcion de PA0 (boton B1) y llama al
#                        driver HAL, que a su vez limpiara el pending bit y
#                        ejecutara HAL_GPIO_EXTI_Callback().
#   - EXTI1_IRQHandler   idem para PA1 (B2).
#   - EXTI9_5_IRQHandler idem para PC6 (B3), que pertenece al grupo de
#                        lineas EXTI [5:9] (comparten una unica ISR).
#   - HAL_GPIO_EXTI_Callback  es una funcion __weak provista por HAL que
#                             se sobreescribe aqui. Recibe el pin que
#                             disparo la interrupcion y delega en el
#                             modulo buttons_app para el debounce y set
#                             de tarea en el sequencer.
